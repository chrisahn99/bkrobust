%% mugango-apostila.sty — the shared preamble for the Mugango apostilas.
%%
%% WHY THIS FILE EXISTS. On 2026-08-23 `scripts/apostila_index.py` measured eleven
%% apostilas, 583 pages, and **21 distinct tcolorbox environment names for 8 semantic
%% roles**, across eleven preambles of 3032–6172 bytes, none shared. Each apostila had
%% been started by hand-copying the previous one, so the visual vocabulary drifted:
%% `formula`/`formulabox`, `armadilha`/`alerta`, `medido`/`numeros`/`ganho`/`conta`,
%% `noprato`/`nocodigo`/`noeixo`/`nomundo`/`noseu`/`naranha`. No style rule and no lint
%% is enforceable while the preamble is copy-pasted, so this package comes first.
%%
%% Every legacy name still works — they are aliases onto the canonical role, keeping
%% their own default titles so the eleven existing apostilas keep compiling and keep
%% reading the way they were written.
%%
%% WHAT IS NEW, and the evidence for it (see wiki/reference/didactic-design-evidence.md
%% for the audited sources; every number below survived an adversarial check):
%%
%%   \prompt{q}{a}   in-prose retrieval practice with the answer printed in the book.
%%                   Retrieval practice WITH feedback g=0.73 [0.61,0.86]; without it
%%                   g=0.39; and with no feedback plus <=50% initial success g=0.03,
%%                   p=.79 — a measured zero (Rowland 2014). A prompt whose answer is
%%                   not resolvable inside the same artifact is not a weak prompt.
%%   antes           2–4 prequestions before a section. Text passages, 48 h: d=0.78,
%%                   d=2.04 with feedback (Pan & Carpenter 2023).
%%   naopasse        a comprehension-FAILURE prompt, never a confirmation checkbox.
%%                   Poor learners detect their own failure 15% of the time vs 46%
%%                   (Chi 2000) — detection is the bottleneck, not repair.
%%   \ifrusty        two assistance variants from one source. Prior knowledge governs
%%                   how much ASSISTANCE to give -- d=+0.505 [0.260,0.750] for low-PK
%%                   learners given high assistance, d=-0.428 [-0.647,-0.209] for high-PK
%%                   ones, k=88, j=60, no publication bias (Tetzlaff et al. 2025, full
%%                   text verified) -- and NOT how to lay out the page (Noetel 2022 found
%%                   prior knowledge does not moderate layout: R^2=0.14, p=0.14).
%%                   Default is `rusty` because the asymmetry is explicit in the source:
%%                   "the instructional implication is to rather provide assistance than
%%                   to withhold it when in doubt."  
%%
%% All four write machine-readable records to \jobname.prompts so that
%% `scripts/apostila_deck.py` and `scripts/apostila_probe.py` read the same source the
%% book does and cannot drift from it.
%%
%% Usage:  \usepackage{mugango-apostila}
%%         \apostilahorizonte{180}   % days this material must survive; sets the deck
%%         \apostilatitulo{...}\apostilasubtitulo{...}\apostilaslug{kcm-v2-localidade}
%%
%% Options: rusty | fluent  (default rusty — the asymmetry favours keeping the scaffold)
%%          noprompts       (suppress the record file; for a quick draft build)

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mugango-apostila}[2026/08/23 v1.0 Mugango apostila shared preamble]

\RequirePackage{xkeyval}
\RequirePackage{etoolbox}

\newif\ifmg@rusty  \mg@rustytrue
\newif\ifmg@prompts \mg@promptstrue
\newif\ifmg@english \mg@englishfalse
\DeclareOption{rusty}{\mg@rustytrue}
\DeclareOption{fluent}{\mg@rustyfalse}
\DeclareOption{noprompts}{\mg@promptsfalse}
% `english`: every fixed string the package prints (default box titles, theorem names, the
% prompt and exercise furniture, the answer appendix, \figref) switches to English. Added
% 2026-09-16 for a polycopié addressed to a co-author who does not read Portuguese. Only
% the PRINTED strings change: environment names, the record stream and the lint are
% identical, so the deck and the probe read an English apostila exactly like any other.
\DeclareOption{english}{\mg@englishtrue}
\ProcessOptions\relax

