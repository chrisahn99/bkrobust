% ---------------------------------------------------------------------- colours
% Colour roles follow Okabe & Ito's Color Universal Design assignments; the HEXES BELOW
% ARE NOT THEIRS. Two honest points, both from the 2026-08-23 figure audit:
%   * The jfly primary page presents the palette only as an IMAGE and gives no RGB, hex
%     or CMYK anywhere in its text. The canonical machine-readable values are R's
%     grDevices: #000000 #E69F00 #56B4E9 #009E73 #F0E442 #0072B2 #D55E00 #CC79A7.
%     Cite jfly for the rationale, grDevices for the numbers.
%   * These are darkened variants, chosen for contrast on white paper. The reason the
%     roles matter more than the exact hexes is that a red/green pair carrying
%     `armadilha` vs `medido` has to survive deuteranopia, and CUD's role assignment is
%     what buys that.
% And the caveat that bounds all of it: colour discriminability depends on MARK TYPE —
% a palette validated on large swatches does not transfer to thin lines and small
% scatter points (Szafir 2018, IEEE TVCG 24(1):392-401). For plotted series, direct
% labelling does the work; colour is the redundant channel, never the only one.
\definecolor{azulesc}{HTML}{1F4E79}     % intuition      (CUD blue,   darkened)
\definecolor{vermesc}{HTML}{A83232}     % trap           (CUD vermillion, darkened)
\definecolor{verdesc}{HTML}{2E6B4F}     % measured       (CUD bluish green, darkened)
\definecolor{laranjaesc}{HTML}{C2701C}  % source         (CUD orange, darkened)
\definecolor{roxoesc}{HTML}{5B3E8E}     % for the paper
\definecolor{aguaesc}{HTML}{2A7B9B}     % in practice    (CUD sky blue, darkened)
\definecolor{rosaesc}{HTML}{9B3A6B}     % retrieval prompt
\definecolor{cinzaclaro}{HTML}{F2F3F5}
\definecolor{cinzamedio}{HTML}{9AA0A6}
\definecolor{cinzaescuro}{HTML}{4A4E54}

% --------------------------------------------------------------- theorem envs
% Numbered within `chapter` in a book, within `section` otherwise. The package has to
% load under `article` (the session briefings) and `standalone` (the concept maps), and
% a bare `[chapter]` fails there with "No counter 'chapter' defined" — which is exactly
% how the first concept-map build died.
% (Branch rather than pass a macro: \newtheorem tests \@ifundefined{c@#3} on the literal
% token, so `[\mg@within]` would look for a counter called `\mg@within`.)
\theoremstyle{definition}
\@ifundefined{c@chapter}{%
  \newtheorem{definicao}{\mg@T@definicao}[section]
  \newtheorem{exemplo}{\mg@T@exemplo}[section]
  \theoremstyle{plain}
  \newtheorem{teorema}{\mg@T@teorema}[section]
}{%
  \newtheorem{definicao}{\mg@T@definicao}[chapter]
  \newtheorem{exemplo}{\mg@T@exemplo}[chapter]
  \theoremstyle{plain}
  \newtheorem{teorema}{\mg@T@teorema}[chapter]
}
\newtheorem{proposicao}[teorema]{\mg@T@proposicao}
\newtheorem{lema}[teorema]{\mg@T@lema}
\newtheorem{corolario}[teorema]{\mg@T@corolario}

% ============================================================ the record stream
% Every retrieval artefact in the book writes one record here, so the deck, the
% probe and the lint read exactly what the reader reads. Records are deferred
% (\write, not \immediate\write) so \thepage is the shipped page, not the page
% TeX happened to be building.
%
% Format — one field per line, no delimiter can collide with LaTeX source:
%   @@P <rec> <kind> <chapter> <page> <conceito> <dificuldade> <ref>
%   @@Q <detokenized question>
%   @@A <detokenized answer>
% kind = card | pre | fail ; conceito is a slug with no spaces; ref is the number
% printed next to the answer in the appendix (cards only, else 0).
%
% The write is deferred so \thepage is the SHIPPED page, but everything else must be
% frozen at the call site — a plain \write expands the whole line at shipout, which
% made every record in a page batch report the last counter and the last conceito.
% \protected@write is exactly this: \edef the line now, with \thepage \relax-ed so it
% alone survives to shipout.

\newcounter{mg@rec}
\newwrite\mg@out
\ifmg@prompts
  \immediate\openout\mg@out=\jobname.prompts\relax
\fi

% Under `article` there is no \thechapter, and the record stream must still say WHERE
% the prompt was. Fall back to the section number.
\@ifundefined{c@chapter}{\def\mg@where{\thesection}}{\def\mg@where{\thechapter}}

\newcommand{\mg@emit}[6]{%
  % #1 kind  #2 conceito  #3 dificuldade  #4 question  #5 answer  #6 ref
  \ifmg@prompts
    \stepcounter{mg@rec}%
    \protected@write\mg@out{}{@@P \themg@rec\space #1 \mg@where\space \thepage\space #2 #3 #6}%
    \protected@write\mg@out{}{@@Q \detokenize{#4}}%
    \protected@write\mg@out{}{@@A \detokenize{#5}}%
  \fi
}

% \clearpage FIRST, and it is not decoration. LaTeX's \enddocument runs the
% \AtEndDocument hooks and only then ships the final page, so closing the stream here
% without forcing that shipout drops every deferred record on the last page — silently,
% with no warning and a valid PDF. Caught on the `article` smoke test, where the whole
% document is one page and the record file came out holding nothing but the metadata.
% The \clearpage LaTeX runs afterwards is then a no-op.
\AtEndDocument{\ifmg@prompts\clearpage\immediate\closeout\mg@out\fi}

% Book-level metadata the downstream tools need. `horizonte` is the number of days
% this material must survive; the deck's first review gap is 10–20% of it (Cepeda
% et al. 2008 licenses a FIRST-gap rule and nothing more — it is not a ladder).
\newcommand{\mg@slug}{sem-slug}
\newcommand{\mg@horizonte}{180}
\newcommand{\apostilaslug}[1]{\renewcommand{\mg@slug}{#1}%
  \ifmg@prompts\immediate\write\mg@out{@@META slug #1}\fi}
\newcommand{\apostilahorizonte}[1]{\renewcommand{\mg@horizonte}{#1}%
  \ifmg@prompts\immediate\write\mg@out{@@META horizonte #1}\fi}
\newcommand{\apostilatitulo}[1]{%
  \ifmg@prompts\immediate\write\mg@out{@@META titulo \detokenize{#1}}\fi}
\newcommand{\apostilasubtitulo}[1]{%
  \ifmg@prompts\immediate\write\mg@out{@@META subtitulo \detokenize{#1}}\fi}

% ================================================================ callout boxes
% Eight semantic roles. One visual style per role; several titles per style where
% the author wants a narrower label. Adding a NEW role means adding it here and to
% ROLES in scripts/apostila_index.py — never in a document preamble.

\tcbset{mgbox/.style={breakable, enhanced, boxrule=0.6pt,
    left=3mm, right=3mm, top=2mm, bottom=2mm, fonttitle=\bfseries\sffamily}}

% -- role: intuicao ------------------------------------------------ (blue) ----
\newtcolorbox{ideia}[1][\mg@T@ideia]{mgbox,
  colback=cinzaclaro, colframe=azulesc, boxrule=0.4pt, title={#1}}
\newtcolorbox{analogia}[1][\mg@T@analogia]{mgbox,
  colback=cinzaclaro, colframe=azulesc, boxrule=0.4pt, title={#1}}

% -- role: formal -------------------------------------------------- (grey) ----
\newtcolorbox{formulabox}[1][]{mgbox,
  colback=white, colframe=cinzamedio, boxrule=0.5pt, title={#1}}
\providecommand{\mg@formula}{}
\newtcolorbox{formula}[1][]{mgbox,
  colback=white, colframe=cinzamedio, boxrule=0.5pt, title={#1}}

% -- role: medido -------------------------------------------------- (green) ---
% A green box is a number THIS MACHINE computed, with the script named. A number
% from a paper goes in \fonte with the citation. The distinction was introduced on
% 2026-08-14 and the three apostilas before it do not make it.
\newtcolorbox{medido}[1][\mg@T@medido]{mgbox,
  colback=verdesc!6, colframe=verdesc, title={#1}}
\newtcolorbox{numeros}[1][\mg@T@numeros]{mgbox,
  colback=verdesc!6, colframe=verdesc, title={#1}}
\newtcolorbox{ganho}[1][\mg@T@ganho]{mgbox,
  colback=verdesc!6, colframe=verdesc, title={#1}}
\newtcolorbox{conta}[1][\mg@T@conta]{mgbox,
  colback=verdesc!6, colframe=verdesc, title={#1}}

% -- role: armadilha ------------------------------------------------- (red) ---
\newtcolorbox{armadilha}[1][\mg@T@armadilha]{mgbox,
  colback=vermesc!5, colframe=vermesc, title={#1}}
\newtcolorbox{alerta}[1][\mg@T@alerta]{mgbox,
  colback=vermesc!5, colframe=vermesc, title={#1}}

% -- role: pratica -------------------------------------------------- (aqua) ---
\newtcolorbox{noprato}[1][\mg@T@noprato]{mgbox,
  colback=aguaesc!7, colframe=aguaesc, title={#1}}
\newtcolorbox{nocodigo}[1][\mg@T@nocodigo]{mgbox,
  colback=aguaesc!7, colframe=aguaesc, title={#1}}
\newtcolorbox{noeixo}[1][\mg@T@noeixo]{mgbox,
  colback=aguaesc!7, colframe=aguaesc, title={#1}}
\newtcolorbox{nomundo}[1][\mg@T@nomundo]{mgbox,
  colback=aguaesc!7, colframe=aguaesc, title={#1}}
\newtcolorbox{noseu}[1][\mg@T@noseu]{mgbox,
  colback=aguaesc!7, colframe=aguaesc, title={#1}}
\newtcolorbox{naranha}[1][\mg@T@naranha]{mgbox,
  colback=aguaesc!7, colframe=aguaesc, title={#1}}

% -- role: redacao ------------------------------------------------ (purple) ---
\newtcolorbox{sonorio}[1][\mg@T@sonorio]{mgbox,
  colback=roxoesc!6, colframe=roxoesc, title={#1}}
\newtcolorbox{papel}[1][\mg@T@papel]{mgbox,
  colback=roxoesc!6, colframe=roxoesc, title={#1}}
\newtcolorbox{concede}[1][\mg@T@concede]{mgbox,
  colback=roxoesc!6, colframe=roxoesc, title={#1}}

% -- role: fonte --------------------------------------------------- (orange) --
\newtcolorbox{fonte}[1][\mg@T@fonte]{mgbox,
  colback=laranjaesc!6, colframe=laranjaesc, title={#1}}

% -- role: digressao ------------------------------------------------ (grey) ---
% The war stories, the seven-errors chapter, the negative results. DO NOT purge
% them: on static text of exactly this shape the whole seductive-details cost was
% offset by a grey box plus one up-front thematic-independence sentence
% (d=-.79, BF01=4.57, N=195). \digressaoaviso prints that sentence, once.
\newtcolorbox{digressao}[1][\mg@T@digressao]{mgbox,
  colback=cinzaclaro, colframe=cinzamedio, boxrule=0.4pt,
  fontupper=\small, title={#1}}
\newcommand{\digressaoaviso}{%
  \begin{tcolorbox}[mgbox, colback=cinzaclaro, colframe=cinzamedio, boxrule=0.4pt,
    fontupper=\small, title={\mg@T@sobrecaixas}]
  \mg@T@avisotexto
  \end{tcolorbox}}

% ========================================================== retrieval artefacts

% -- \prompt{pergunta}{resposta} ------------------------------------------------
% In-prose retrieval practice. The question is typeset where the idea was just
% explained; the answer is NOT on the same page — it is collected into the answer
% appendix by \apostilarespostas. (Appendix placement is a design preference, not
% a finding: Rowland's delayed-feedback figure is about temporal delay between
% test and feedback, not spatial placement. Do not cite it for this.)
%
% \prompt[conceito=slug,dificuldade=0.75]{Q}{A}
\newcounter{mg@prompt}
\newcommand{\mg@pconc}{geral}
\newcommand{\mg@pdif}{0.75}
\define@key{mgprompt}{conceito}{\renewcommand{\mg@pconc}{#1}}
\define@key{mgprompt}{dificuldade}{\renewcommand{\mg@pdif}{#1}}

\newcommand{\prompt}[3][]{%
  \renewcommand{\mg@pconc}{geral}\renewcommand{\mg@pdif}{0.75}%
  \setkeys{mgprompt}{#1}%
  \stepcounter{mg@prompt}%
  \mg@emit{card}{\mg@pconc}{\mg@pdif}{#2}{#3}{\themg@prompt}%
  \begin{tcolorbox}[mgbox, colback=rosaesc!5, colframe=rosaesc, boxrule=0.5pt,
      fontupper=\small, title={\mg@T@semolhar \ \textnormal{\normalfont\sffamily\scriptsize
        (\mg@T@resposta\ \themg@prompt, \mg@T@noapendice)}}]
  #2
  \end{tcolorbox}%
  \expandafter\gdef\csname mg@ans@\themg@prompt\endcsname{#3}%
  % \listgadd guarda o argumento SEM expandir; guardar \themg@prompt fazia toda a lista
  % apontar para o valor FINAL do contador, e o apendice imprimia N vezes a ultima
  % resposta. Corrigido 2026-08-25 (apostila hplr-neurocomputing); afeta toda apostila
  % construida antes desta data -- recompilar para corrigir o apendice.
  \edef\mg@thisnum{\arabic{mg@prompt}}%
  \expandafter\listgadd\expandafter\mg@answers\expandafter{\mg@thisnum}%
}
\newcommand{\mg@answers}{}

% The answer appendix. Call it once, near the end, after the last \prompt.
\newcommand{\apostilarespostas}{%
  \@ifundefined{chapter}
    {\section*{\mg@T@respostas}\addcontentsline{toc}{section}{\mg@T@respostas}}
    {\chapter*{\mg@T@respostas}\addcontentsline{toc}{chapter}{\mg@T@respostas}%
     \markboth{\mg@T@RESPOSTAS}{\mg@T@RESPOSTAS}}%
  \begingroup
  \setlength{\parskip}{0.4em}%
  \renewcommand*{\do}[1]{%
    \par\noindent\textbf{\textcolor{rosaesc}{##1.}}\ \csname mg@ans@##1\endcsname\par}%
  \dolistloop{\mg@answers}%
  \endgroup}

% -- antes: prequestions --------------------------------------------------------
% 2–4 questions immediately BEFORE a section. Budget them against the propositions
% you intend to still hold in six months, not against the page count: the spillover
% to un-asked content is inconsistent (Pan & Rickard 2018: d=0.16, p=.20, and
% PEESE-corrected to -0.32).
\newenvironment{antes}[1][\mg@T@antes]
  {\begin{tcolorbox}[mgbox, colback=azulesc!4, colframe=azulesc!70, boxrule=0.5pt,
      fontupper=\small, title={#1}]%
   \begin{itemize}[leftmargin=*, nosep, label=\textcolor{azulesc}{$\circ$}]}
  {\end{itemize}\end{tcolorbox}}
% one question inside `antes`, recorded so the lint can check the section answers it
\newcommand{\antesq}[2][geral]{\item #2\mg@emit{pre}{#1}{0.50}{#2}{}{0}}

% -- naopasse: the comprehension-FAILURE prompt ---------------------------------
% At the end of a section. Never "você entendeu? (s/n)": Chi's protocols put poor
% learners' failure-detection at 15% vs 46%, and "the poor learners thought they
% understood most of the time when in fact they did not". The prompt must force
% naming a SPECIFIC step.
\newcommand{\naopasse}[2][geral]{%
  \mg@emit{fail}{#1}{0.50}{#2}{}{0}%
  \begin{tcolorbox}[mgbox, colback=cinzaescuro!5, colframe=cinzaescuro, boxrule=0.5pt,
      fontupper=\small, title={\mg@T@naopasse}]
  #2
  \end{tcolorbox}}

% -- exercicio, with an interleaving tag ----------------------------------------
% `metodo=` names the strategy the exercise requires. `apostila_lint.py` fails the
% build when two consecutive exercises share a metodo, because interleaving trains
% strategy SELECTION and that is what a derivation needs months later (Rohrer et al.
% 2020, preregistered cluster RCT, 54 classes, 787 students: 61% vs 38%, d=0.83).
% NB interleave EXERCISES only — never the prose, the glossary or the notation
% drills: for verbal material blocking wins (Brunmair & Richter, words g=-0.39).
\@ifundefined{c@chapter}
  {\newcounter{mg@exer}[section]\renewcommand{\themg@exer}{\thesection.\arabic{mg@exer}}}
  {\newcounter{mg@exer}[chapter]\renewcommand{\themg@exer}{\thechapter.\arabic{mg@exer}}}
\newcommand{\mg@emeth}{sem-metodo}
\newcommand{\mg@econc}{geral}
\newcommand{\mg@ename}{}
\define@key{mgexer}{metodo}{\renewcommand{\mg@emeth}{#1}}
\define@key{mgexer}{conceito}{\renewcommand{\mg@econc}{#1}}

% The optional argument is DUAL-MODE, and it has to be: nine of the eleven existing
% apostilas were written against the amsthm convention where `[...]` is the exercise's
% NAME, and `\begin{exercicio}[A identidade]` must not become a key-value parse error.
% So: an argument containing `=` is options, anything else is a name.
\newcommand{\mg@exerarg}[1]{%
  \def\mg@tmp{#1}%
  \ifx\mg@tmp\@empty\else
    \in@{=}{#1}%
    \ifin@ \setkeys{mgexer}{#1}\else \renewcommand{\mg@ename}{#1}\fi
  \fi}

\newenvironment{exercicio}[1][]
  {\renewcommand{\mg@emeth}{sem-metodo}\renewcommand{\mg@econc}{geral}%
   \renewcommand{\mg@ename}{}%
   \mg@exerarg{#1}%
   \refstepcounter{mg@exer}%
   \ifmg@prompts
     \protected@write\mg@out{}{@@X \themg@exer\space \mg@where\space \thepage\space
       \mg@emeth\space \mg@econc}%
   \fi
   \par\medskip\noindent\textbf{\textcolor{azulesc}{\mg@T@exercicio\ \themg@exer.}}%
   % \mg@ename vem de \newcommand, que e \long; \@empty nao e, entao um \ifx entre os
   % dois e SEMPRE falso e um exercicio so com opcoes key-value imprimia "()" vazio.
   \ifdefempty{\mg@ename}{}{\ \textbf{\textcolor{azulesc}{(\mg@ename)}}}%
   \ \itshape}
  {\par\medskip}

\newenvironment{solucao}
  {\par\noindent\textbf{\mg@T@solucao.}\ }
  {\par\medskip}

% -- \figref: a reference that can be linted ------------------------------------
% Spatial contiguity is the largest layout effect in the field (g=0.63, 58 independent
% comparisons, n=2,426; Schroeder & Cenkci 2018) and a floating figure silently breaks
% it. \figref records the page the REFERENCE was shipped on; the .aux records the page
% the FIGURE was shipped on; `scripts/apostila_lint.py` compares the two. This is also
% the check that catches an uncited figure — the KCM v2 clarity review found 11 of 14
% computed figures were never referenced in the text.
\newcommand{\figref}[1]{%
  \ifmg@prompts\protected@write\mg@out{}{@@R #1 \thepage}\fi
  \mg@T@figura~\ref{#1}}
\newcommand{\figrefs}[1]{%
  \ifmg@prompts\protected@write\mg@out{}{@@R #1 \thepage}\fi
  \ref{#1}}

% -- \ifrusty: the assistance switch --------------------------------------------
% Two variants of the ASSISTANCE, from one source. Never two page layouts: prior
% knowledge did not moderate multimedia design-principle effects (Noetel et al.
% 2022, N=30 pooled effects, R^2=0.14, p=0.14). Default is `rusty` because the
% measured asymmetry favours giving help when the measurement is ambiguous.
\newcommand{\enferrujado}[1]{\ifmg@rusty#1\fi}
\newcommand{\fluente}[1]{\ifmg@rusty\else#1\fi}
% For a concept he demonstrably still owns, DELETE the annotation rather than
% integrating it — redundant integrated text is worse than none (Kalyuga 2003).
\newcommand{\andaime}[1]{\ifmg@rusty#1\fi}

